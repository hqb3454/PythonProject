# Source root after git clone.
APP_ROOT=/opt/campus-assistant
REPO_DIR=/opt/campus-assistant/repo

# Local model directory on the cloud host.
RAG_MODEL_DIR=/opt/campus-assistant/models

# Backend -> MCP. Keep this private to the cloud host.
RAG_MCP_URL=http://127.0.0.1:8766/mcp

# FastAPI stays private on the cloud host; access it through SSH tunnel or Vite proxy.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false

# HTTP MCP server should stay private.
MCP_HOST=127.0.0.1
MCP_PORT=8766

# Optional LLM generation key. RAG retrieval works without it, but final answers
# are much better when a provider is configured.
#
# --- Gemini (google-genai, preferred on the cloud host) ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# CAMPUS_ASSISTANT_MODEL=gemini-2.5-flash
#
# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# --- Kimi / Moonshot (OpenAI-compatible) ---
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k
# KIMI_BASE_URL=https://api.moonshot.ai/v1
#
# Common tuning:
# LLM_TEMPERATURE=0.2
