# Copy this file to .env for local backend development.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi / Moonshot OpenAI-compatible API
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Backend -> HTTP MCP server
RAG_MCP_URL=http://127.0.0.1:8766/mcp

# Optional
LLM_TEMPERATURE=0.2
